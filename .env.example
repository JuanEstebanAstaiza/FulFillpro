# Base de datos
DATABASE_URL=postgresql+psycopg://fulfillpro:fulfillpro@localhost:5432/fulfillpro

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=100

# Seguridad JWT
JWT_SECRET=cambia-este-secreto-en-produccion-usa-uno-largo
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=14

# Admin bootstrap (se crea al arrancar si no existe)
ADMIN_EMAIL=admin@fulfillpro.com
ADMIN_PASSWORD=AdminFulfillPro2026!
ADMIN_NAME=Administrador

# Almacenamiento de archivos
STORAGE_ROOT=./storage
STORAGE_MAX_GB=100
# Techo por archivo (MB). 25 MB × 100 subidas concurrentes ≈ 2.5 GB pico teórico en API
MAX_UPLOAD_MB=25

# App
# production: exige JWT_SECRET fuerte (≥32), ADMIN_PASSWORD no default, CORS sin *
APP_ENV=production
# Dominio público (Cloudflare Tunnel)
CORS_ORIGINS=https://fulfillpro.app,https://www.fulfillpro.app
ALLOW_PUBLIC_REGISTER=false
SEED_DEMO_USERS=false
MAX_ROWS=60000
MAX_CANT_COLS=60
DEVICE_STALE_DAYS=60

# Capacidad (perfil stack 12 GB: api 2G + worker 6G + db 3G + redis 0.5G)
UVICORN_WORKERS=4
DB_POOL_SIZE=12
DB_MAX_OVERFLOW=8
PROCESS_MAX_QUEUE=500
WORKER_CONCURRENCY=3

# Rate limiting (encolado, no ejecución Excel)
# 100+ perfiles: techo por usuario e IP; la ejecución real la limitan los workers
RATE_LIMIT_LOGIN=10
RATE_LIMIT_PROCESS=150
RATE_LIMIT_PROCESS_IP=500
