# Base de datos
DATABASE_URL=postgresql+psycopg://fulfillpro:fulfillpro@localhost:5432/fulfillpro

# Redis
REDIS_URL=redis://localhost:6379/0

# Seguridad JWT
JWT_SECRET=cambia-este-secreto-en-produccion-usa-uno-largo
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=14

# Admin bootstrap (se crea al arrancar si no existe)
ADMIN_EMAIL=admin@fulfillpro.com
ADMIN_PASSWORD=AdminFulfillPro2026!
ADMIN_NAME=Administrador

# Almacenamiento de archivos
STORAGE_ROOT=./storage
# Política de capacidad de disco del despliegue auditado (100 GB)
STORAGE_MAX_GB=100

# App
# production: exige JWT_SECRET fuerte (≥32), ADMIN_PASSWORD no default, CORS sin *
APP_ENV=development
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
ALLOW_PUBLIC_REGISTER=true
SEED_DEMO_USERS=true
MAX_ROWS=60000
MAX_CANT_COLS=60
DEVICE_STALE_DAYS=60

# Capacidad (perfil stack 12 GB RAM: api 7G + db 4G + redis 0.5G)
UVICORN_WORKERS=3
DB_POOL_SIZE=12
DB_MAX_OVERFLOW=8

# Rate limiting
RATE_LIMIT_LOGIN=10
RATE_LIMIT_PROCESS=30

