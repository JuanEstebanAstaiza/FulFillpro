# =============================================================================
# FulfillPro — .env TEMPORAL EN REPOSITORIO
# =============================================================================
# ⚠ ADVERTENCIA DE SEGURIDAD:
#   Este archivo se subió al Git de forma TEMPORAL para facilitar el despliegue
#   en Proxmox. En el SIGUIENTE commit debe eliminarse del repo y volver a
#   ignorarse (.gitignore). Rota JWT_SECRET y ADMIN_PASSWORD tras quitarlo.
# =============================================================================

# ── Base de datos (en Docker el compose fuerza host "db") ──
DATABASE_URL=postgresql+psycopg://fulfillpro:fulfillpro@db:5432/fulfillpro

# ── Redis ──
REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=100

# ── Seguridad JWT (valores generados para este despliegue) ──
JWT_SECRET=Mw6QiUjKQKCELHzRYy1u1W00JuYOJmQpgbLga-dcH4qMybniyq4ULBDf9U3eKzvL
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=14

# ── Admin de plataforma (/ops) ──
ADMIN_EMAIL=admin@fulfillpro.com
ADMIN_PASSWORD=WARfKaiQP2mhUTpqgBnF-BAY
ADMIN_NAME=Administrador FulfillPro

# ── Almacenamiento ──
STORAGE_ROOT=/app/storage
STORAGE_MAX_GB=100
MAX_UPLOAD_MB=25

# ── App (producción en el servidor) ──
# Si publicas con Cloudflared, añade tu dominio real a CORS_ORIGINS, por ejemplo:
#   CORS_ORIGINS=https://app.tudominio.com,https://tudominio.com
# Misma origin (app y API en el mismo host) suele funcionar aunque CORS no liste el dominio.
APP_ENV=production
CORS_ORIGINS=https://localhost,http://localhost:8000,http://127.0.0.1:8000
ALLOW_PUBLIC_REGISTER=false
SEED_DEMO_USERS=false

MAX_ROWS=60000
MAX_CANT_COLS=60
DEVICE_STALE_DAYS=60

# ── Capacidad (VM ~12 GB) ──
UVICORN_WORKERS=4
DB_POOL_SIZE=12
DB_MAX_OVERFLOW=8
PROCESS_MAX_QUEUE=500
WORKER_CONCURRENCY=3

# ── Rate limits ──
RATE_LIMIT_LOGIN=10
RATE_LIMIT_PROCESS=150
RATE_LIMIT_PROCESS_IP=500
